# ---------------------------------------------------------------------------
# Spotter Route Weather — environment template
# Copy to .env (repo root, for docker-compose) and to backend/.env for local dev.
# NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Backend core -----------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate one for production: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Identify your deployment to Nominatim (required by their usage policy).
APP_USER_AGENT=spotter-weather-routing/1.0 (assessment)

# --- Routing ----------------------------------------------------------------
# Optional but recommended: free key at https://openrouteservice.org/dev/#/signup
# Enables the truck-aware driving-hgv profile and up to 3 alternatives.
ORS_API_KEY=
# Optional tertiary fallback (car profile; truck profiles are a paid custom model).
GRAPHHOPPER_API_KEY=
# Keyless fallbacks (defaults shown; normally leave unset).
OSRM_BASE_URL=https://router.project-osrm.org

# --- Weather / geocoding ----------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Caching (seconds) ------------------------------------------------------
GEOCODE_CACHE_TTL=86400
ROUTE_CACHE_TTL=3600
WEATHER_CACHE_TTL=1800
ANALYSIS_CACHE_TTL=21600
# Optional shared cache for multi-worker deployments:
# REDIS_URL=redis://localhost:6379/1

# --- Frontend ---------------------------------------------------------------
# Where the browser sends API calls. Leave empty to use the Vite/nginx proxy.
# For Vercel + Render set this to your Render URL, e.g. https://api.example.com
VITE_API_BASE_URL=
# Dev-only proxy target used by Vite (server-side).
VITE_PROXY_TARGET=http://localhost:8000
